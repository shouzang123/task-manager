{
  "name": "liguangyu-task-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "智能任务管理系统 - Node.js + React + Supabase（liguangyu）",
  "scripts": {
    "dev": "concurrently -n 后端,前端 -c cyan,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "demo": "vite build --config vite.demo.config.js && node scripts/inline-demo.mjs",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.4.8"
  }
}
